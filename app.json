{
  "expo": {
    "name": "TunisianChat",
    "slug": "tunisianchat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-new.png",
    "scheme": "tunisianchat",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.hamzahadded123.tunisianchat",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
       "backgroundColor": "#FDF5E6", // هذا لون الخلفية متاع تصويرة الشاشية باش تجي متناسقة
       "foregroundImage": "./assets/images/icon-new.png"
      }
    },
    "extra": {
      "eas": {
        "projectId": "b0c391fb-fbfd-43eb-96ed-8ded3add2672"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.jpg",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-video",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}